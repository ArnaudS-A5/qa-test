<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      ============================================================================
      qa-test — Projet de tests automatisés (consommateur du socle QA)
      ============================================================================
      Stack : Selenium Java / Serenity BDD (sans Cucumber) / JUnit 5 / Maven,
      en Page Object Model (PageObjects + Steps).

      Principe (cf. qa-template / décision D6-bis) :
        - On HÉRITE de `qa-parent` : il pilote TOUTES les versions (dépendances ET
          plugins). Ce projet ne fixe AUCUNE version lui-même.
        - On ajoute UNE SEULE dépendance : `qa-socle`. Elle réexporte (scope compile)
          Selenium, Serenity, JUnit 5, Apache POI et le log (SLF4J + Logback). On ne
          redéclare donc jamais Selenium ni Serenity ici : ce sont des dépendances
          TRANSITIVES fournies par le socle.
        - Monter de version le socle = bumper la version du <parent> ci-dessous
          (une seule ligne) ; la version de qa-socle suit via ${project.parent.version}.
      ============================================================================
    -->

    <parent>
        <groupId>com.example.qa</groupId>
        <artifactId>qa-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <!-- Résolution depuis le dépôt (Artifactory en CI ; ~/.m2 en local),
             pas depuis le système de fichiers. -->
        <relativePath/>
    </parent>

    <groupId>org.automation</groupId>
    <artifactId>qa-test</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <!-- Un test en échec ne stoppe pas la campagne : toutes les exécutions Surefire tournent et
             l'on obtient 100 % des résultats. Surchargeable : -Dmaven.test.failure.ignore=false. -->
        <maven.test.failure.ignore>true</maven.test.failure.ignore>
    </properties>

    <dependencies>
        <!--
          Unique dépendance du projet : le socle QA. Sa version suit celle du parent.
          Elle apporte transitivement (scope compile, réexporté par le socle) :
            - org.seleniumhq.selenium:selenium-java   (Selenium)
            - net.serenity-bdd:serenity-core          (Serenity BDD)
            - net.serenity-bdd:serenity-junit5        (intégration JUnit 5)
            - org.apache.poi:poi / poi-ooxml          (données Excel/CSV)
            - org.slf4j:slf4j-api + ch.qos.logback    (journalisation)
            - org.junit.jupiter:junit-jupiter         (JUnit 5)
          -> aucune de ces dépendances n'est redéclarée ici.
        -->
        <dependency>
            <groupId>com.example.qa</groupId>
            <artifactId>qa-socle</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Exécution des tests (versions/config héritées de qa-parent). Configuration commune à
                 TOUTES les exécutions (default-test et celles du profil campagne). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <testFailureIgnore>${maven.test.failure.ignore}</testFailureIgnore>
                </configuration>
            </plugin>

            <!-- Agrégation du rapport Serenity : `mvn serenity:aggregate`
                 (HTML sous target/site/serenity/). Version pilotée par qa-parent. -->
            <plugin>
                <groupId>net.serenity-bdd.maven.plugins</groupId>
                <artifactId>serenity-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>serenity-reports</id>
                        <phase>post-integration-test</phase>
                        <goals><goal>aggregate</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Campagne complète en UNE commande par navigateur :
            mvn clean verify                               (Chrome, défaut de serenity.conf)
            mvn clean verify -Dwebdriver.driver=firefox    (Firefox)

          Les timeouts du socle se règlent par clés (qa.sync.*). Un même profil ne peut pas être à la fois
          « surchargé » et « par défaut » dans une JVM : chaque groupe de tests = une exécution Surefire
          (ses JVM + ses propriétés), sélectionnée par PACKAGE :
            - org/automation/sync/cle/**        → exécution « cle »        : clés posées ci-dessous ;
            - org/automation/sync/precedence/** → exécution « precedence » : environment surchargé (T24) ;
            - org/automation/sync/polling/**    → exécution « polling »    : intervalle de sondage surchargé (T78) ;
            - org/automation/websync/etat/soft/** → exécution « soft »     : assertions souples activées, SHORT à
                                                  1 s (T82, @Disabled : lancé à la main par cette exécution) ;
            - tout le reste                     → exécution « defaut »     : AUCUNE clé (défauts du socle).
          « defaut » ramasse tout ce qui n'est pas dans les autres : un nouveau test n'est jamais oublié.
          Les tests aux limites LISENT ces valeurs (support/Timeouts) pour en déduire leurs délais
          (cible à timeout ± 5 s) : les valeurs ne sont écrites qu'ici.

          forkCount : 15 JVM (donc 15 navigateurs) en parallèle par exécution, une classe de test par JVM.
          Les exécutions, elles, s'enchaînent (Maven ne les parallélise pas).

          Actif sauf si -Dtest=... est passé : `mvn test -Dtest=X` garde son comportement habituel (sans
          clé ; un test du groupe cle le signale alors explicitement). Hors campagne : les tests @Disabled
          (producteurs d'échec volontaire, T17 et T82 soft-assert), lancés à la main (README « Lancer les tests »).
        -->
        <profile>
            <id>campagne</id>
            <activation>
                <property>
                    <name>!test</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <forkCount>15</forkCount>
                        </configuration>
                        <executions>
                            <!-- Remplacée par les 5 exécutions ci-dessous (qui couvrent tous les tests). -->
                            <execution>
                                <id>default-test</id>
                                <configuration>
                                    <skip>true</skip>
                                </configuration>
                            </execution>

                            <!-- Groupe « defaut » : aucune clé qa.sync.* → profils aux défauts du socle
                                 (SHORT 5s, MEDIUM 15s, LONG 60s, EXTRA_LONG 120s, pageLoadTimeout 2 min). -->
                            <execution>
                                <id>defaut</id>
                                <phase>test</phase>
                                <goals><goal>test</goal></goals>
                                <configuration>
                                    <excludes>
                                        <exclude>**/*$*</exclude>
                                        <exclude>org/automation/sync/cle/**</exclude>
                                        <exclude>org/automation/sync/precedence/**</exclude>
                                        <exclude>org/automation/sync/polling/**</exclude>
                                        <exclude>org/automation/websync/etat/soft/**</exclude>
                                    </excludes>
                                </configuration>
                            </execution>

                            <!-- Groupe « cle » : chaque clé DIFFÈRE du défaut, sinon rien ne prouverait qu'elle
                                 est lue (short/medium au-dessus du défaut, long/extraLong en dessous). -->
                            <execution>
                                <id>cle</id>
                                <phase>test</phase>
                                <goals><goal>test</goal></goals>
                                <configuration>
                                    <includes>
                                        <include>org/automation/sync/cle/**/*Test.java</include>
                                    </includes>
                                    <systemPropertyVariables>
                                        <qa.sync.timeout.short>10s</qa.sync.timeout.short>
                                        <qa.sync.timeout.medium>25s</qa.sync.timeout.medium>
                                        <qa.sync.timeout.long>30s</qa.sync.timeout.long>
                                        <qa.sync.timeout.extraLong>40s</qa.sync.timeout.extraLong>
                                        <qa.sync.pageLoadTimeout>10s</qa.sync.pageLoadTimeout>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>

                            <!-- Groupe « precedence » : T24, précédence -D > serenity.conf. Isolé pour que le
                                 reste de la campagne garde {ENV}=QATEST dans le nommage des artefacts KO__. -->
                            <execution>
                                <id>precedence</id>
                                <phase>test</phase>
                                <goals><goal>test</goal></goals>
                                <configuration>
                                    <includes>
                                        <include>org/automation/sync/precedence/**/*Test.java</include>
                                    </includes>
                                    <systemPropertyVariables>
                                        <environment>override-D</environment>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>

                            <!-- Groupe « polling » : T78, intervalle de sondage du socle. Isolé pour que les tests
                                 aux limites des autres groupes gardent le sondage par défaut (250 ms) ; la valeur
                                 DIFFÈRE du défaut, sinon rien ne prouverait qu'elle est lue. -->
                            <execution>
                                <id>polling</id>
                                <phase>test</phase>
                                <goals><goal>test</goal></goals>
                                <configuration>
                                    <includes>
                                        <include>org/automation/sync/polling/**/*Test.java</include>
                                    </includes>
                                    <systemPropertyVariables>
                                        <qa.sync.pollingInterval>2000ms</qa.sync.pollingInterval>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>

                            <!-- Groupe « soft » : T82, assertions souples (should* collectés, KO agrégé en fin de
                                 test). Isolé : partout ailleurs les should* restent durs (serenity.conf).
                                 T82 est rouge à dessein, donc @Disabled : lancé à la main par cette exécution
                                 (README, « Lancer les tests » §6).
                                 SHORT à 1 s : un should* en échec attend le timeout du profil avant d'être
                                 collecté ; sur une page statique, attendre davantage n'apporte rien. -->
                            <execution>
                                <id>soft</id>
                                <phase>test</phase>
                                <goals><goal>test</goal></goals>
                                <configuration>
                                    <includes>
                                        <include>org/automation/websync/etat/soft/**/*Test.java</include>
                                    </includes>
                                    <systemPropertyVariables>
                                        <qa.assertions.soft>true</qa.assertions.soft>
                                        <qa.sync.timeout.short>1s</qa.sync.timeout.short>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
